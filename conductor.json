{
  "scripts": {
    "setup": "git -C \"$CONDUCTOR_ROOT_PATH\" fetch --prune origin && git -C \"$CONDUCTOR_ROOT_PATH\" pull --ff-only || true",
    "run": "python3 -m http.server ${CONDUCTOR_PORT:-8000}",
    "archive": "node -e \"const fs=require('fs');const c=fs.readFileSync('index.html','utf8');const s=c.slice(c.indexOf('<script>')+8,c.lastIndexOf('</script>'));try{new Function(s);process.stdout.write('JS OK\\n')}catch(e){process.stderr.write('JS ERROR: '+e.message+'\\n');process.exit(1)}\""
  },
  "runScriptMode": "concurrent"
}
