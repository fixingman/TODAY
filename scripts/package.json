{
  "name": "today-scripts",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Dev-only tooling for TODAY — not part of the app",
  "scripts": {
    "test": "node test-all.mjs",
    "performance": "node performance-test.mjs",
    "performance:write": "node performance-test.mjs --write",
    "visual": "node visual-test.mjs",
    "visual:update": "node visual-test.mjs --update",
    "test:changed": "node test-all.mjs --changed",
    "test:ci": "node ci-execution.mjs --run",
    "test:policy": "node ci-execution.mjs",
    "test:release": "node test-all.mjs && node performance-test.mjs --no-audit-check",
    "test:shadow": "node test-all.mjs --shadow",
    "test:plan": "node ci-plan.mjs"
  },
  "dependencies": {
    "@puppeteer/browsers": "3.2.2",
    "axe-core": "^4.13.0",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "25.10.0"
  }
}
